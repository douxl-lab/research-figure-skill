# Research Figure Studio: deny local and confidential state by default.
# Git ignores only UNTRACKED files; after a previous commit, run:
#   git rm --cached <path>
# A separate tracked-file safeguard runs in CI.

# Python virtual environments, dependencies and caches
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.pyre/
.pytype/
.coverage*
coverage.xml
htmlcov/
*.egg-info/
build/
dist/
site-packages/

