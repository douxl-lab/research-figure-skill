{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:research-figure:figure-spec:v0.1.0",
  "title": "Research FigureSpec v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "figure_id",
    "type",
    "title",
    "scientific_claim",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "figure_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "type": {
      "enum": [
        "architecture",
        "quantitative",
        "editable_reconstruction",
        "evidence_panel"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scientific_claim": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "method",
              "code",
              "data",
              "reference",
              "hypothesis"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "pending",
              "illustrative"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "diagram": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "emphasis": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "feedback": {
                "type": "boolean"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "plot": {
      "type": "object",
      "required": [
        "kind",
        "data_file",
        "x",
        "y"
      ],
      "properties": {
        "kind": {
          "enum": [
            "bar",
            "line",
            "scatter"
          ]
        },
        "data_file": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "string",
          "minLength": 1
        },
        "y": {
          "type": "string",
          "minLength": 1
        },
        "series": {
          "type": "string"
        },
        "x_label": {
          "type": "string"
        },
        "y_label": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string"
        },
        "demo": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "intent": {
          "enum": [
            "exact",
            "creative"
          ]
        },
        "archetype": {
          "enum": [
            "overview",
            "architecture",
            "mechanism"
          ]
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 500,
          "maximum": 8000
        },
        "height_px": {
          "type": "integer",
          "minimum": 300,
          "maximum": 8000
        },
        "publication_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "editable": {
          "type": "boolean"
        },
        "formats": {
          "type": "array",
          "items": {
            "enum": [
              "svg",
              "pdf",
              "png",
              "pptx",
              "drawio"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "reading_path": {
          "enum": [
            "left_to_right",
            "top_to_bottom",
            "radial",
            "hierarchical"
          ]
        },
        "visual_priority": {
          "type": "string",
          "minLength": 1
        },
        "layout_notes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text_notes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "connector_notes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "asset_notes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "architecture"
          }
        }
      },
      "then": {
        "required": [
          "diagram"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "quantitative"
          }
        }
      },
      "then": {
        "required": [
          "plot"
        ]
      }
    }
  ],
  "additionalProperties": false
}
