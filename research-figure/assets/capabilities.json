{
  "format": "rfs-capabilities/2.0",
  "version": "0.8.1",
  "upstream_lock": "assets/upstreams.lock.json",
  "modules": [
    {
      "id": "design",
      "role": "source-grounded five-stage creative design",
      "guide": "references/design-core.md",
      "runtime": "kernels/design",
      "entry": "scripts/kernel.py",
      "modes": [
        "design-native",
        "design-provider"
      ]
    },
    {
      "id": "layout",
      "role": "local template/gallery library, vector export and audits",
      "guide": "references/layout-library.md",
      "runtime": "kernels/layout",
      "entry": "scripts/library.py",
      "mode": "layout"
    },
    {
      "id": "vector",
      "role": "explicit TikZ/math vector source",
      "guide": "references/tikz-workflow.md",
      "entry": "scripts/tikz_renderer.py"
    },
    {
      "id": "plot",
      "role": "real source data only",
      "guide": "references/recipes.md",
      "entry": "scripts/plotting.py"
    },
    {
      "id": "reconstruction",
      "role": "approved-reference native editing",
      "guide": "references/reconstruction.md",
      "entry": "scripts/emit_bundle.py"
    },
    {
      "id": "audit",
      "role": "science, real bytes, native objects and exports",
      "guide": "references/quality-gates.md",
      "entry": "scripts/native_qa.py"
    }
  ]
}
